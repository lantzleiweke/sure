<%# locals: (lunch_money_item:) %>

<%= tag.div id: dom_id(lunch_money_item) do %>
  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex w-full items-center justify-between gap-2">
        <div class="flex min-w-0 items-center gap-2">
          <%= icon "chevron-right", class: "shrink-0 group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>

          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-500/10 ring-1 ring-amber-500/10">
            <% if lunch_money_item.logo.attached? %>
              <%= image_tag lunch_money_item.logo, class: "h-full w-full rounded-full", loading: "lazy" %>
            <% else %>
              <%= tag.p "LM", class: "text-[10px] font-semibold tracking-tight text-amber-700 dark:text-amber-400" %>
            <% end %>
          </div>

          <div class="min-w-0 pl-1 text-sm">
            <div class="flex items-center gap-2">
              <%= tag.p lunch_money_item.name, class: "truncate font-medium text-primary" %>
              <% if lunch_money_item.scheduled_for_deletion? %>
                <p class="shrink-0 text-sm text-destructive animate-pulse"><%= t(".deletion_in_progress") %></p>
              <% end %>
            </div>
            <p class="text-xs text-secondary"><%= t(".provider_name") %></p>

            <% if lunch_money_item.syncing? %>
              <div class="flex items-center gap-1 text-secondary">
                <%= icon "loader", size: "sm", class: "animate-spin" %>
                <%= tag.span t(".syncing") %>
              </div>
            <% elsif lunch_money_item.sync_error.present? %>
              <div class="flex items-center gap-1 text-secondary">
                <%= render DS::Tooltip.new(text: lunch_money_item.sync_error, icon: "alert-circle", size: "sm", color: "destructive", as: :span) %>
                <%= tag.span t(".error"), class: "text-destructive" %>
              </div>
            <% elsif lunch_money_item.requires_update? %>
              <div class="flex items-center gap-1 text-warning">
                <%= icon "alert-triangle", size: "sm", color: "warning" %>
                <%= tag.span t(".requires_update") %>
              </div>
            <% elsif lunch_money_item.last_synced_at %>
              <p class="text-secondary">
                <%= t(".status_with_summary", timestamp: time_ago_in_words(lunch_money_item.last_synced_at), summary: lunch_money_item.sync_status_summary) %>
              </p>
            <% else %>
              <p class="text-secondary"><%= t(".status_never") %></p>
            <% end %>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <% if lunch_money_item.requires_update? %>
            <%= render DS::Link.new(
              text: t(".update_credentials"),
              icon: "key-round",
              variant: "secondary",
              href: settings_providers_path,
              frame: "_top"
            ) %>
          <% else %>
            <%= icon(
              "refresh-cw",
              as_button: true,
              href: sync_lunch_money_item_path(lunch_money_item),
              disabled: lunch_money_item.syncing?
            ) %>
          <% end %>

          <%= render DS::Menu.new do |menu| %>
            <% menu.with_item(
              variant: "button",
              text: t(".delete"),
              icon: "trash-2",
              href: lunch_money_item_path(lunch_money_item),
              method: :delete,
              confirm: CustomConfirm.for_resource_deletion(lunch_money_item.name, high_severity: true)
            ) %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% unless lunch_money_item.scheduled_for_deletion? %>
      <div class="mt-4 space-y-4">
        <% if lunch_money_item.accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: lunch_money_item.accounts %>
        <% end %>

        <% stats = if defined?(@lunch_money_sync_stats_map) && @lunch_money_sync_stats_map
             @lunch_money_sync_stats_map[lunch_money_item.id] || {}
           else
             lunch_money_item.syncs.ordered.first&.sync_stats || {}
           end %>
        <%= render ProviderSyncSummary.new(stats: stats, provider_item: lunch_money_item) %>

        <% unlinked_count = lunch_money_item.unlinked_accounts_count %>
        <% linked_count = lunch_money_item.linked_accounts_count %>
        <% total_count = lunch_money_item.total_accounts_count %>

        <% if unlinked_count.positive? %>
          <div class="flex flex-col items-center justify-center gap-3 rounded-lg bg-amber-500/5 p-4 text-center">
            <p class="text-sm font-medium text-primary"><%= t(".setup_needed") %></p>
            <p class="text-sm text-secondary"><%= t(".setup_description", linked: linked_count, total: total_count) %></p>
            <%= render DS::Link.new(
              text: t(".setup_action"),
              icon: "settings",
              variant: "primary",
              href: setup_accounts_lunch_money_item_path(lunch_money_item),
              frame: :modal
            ) %>
          </div>
        <% elsif lunch_money_item.accounts.empty? && total_count.zero? %>
          <div class="flex flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-amber-500/25 p-4 text-center">
            <p class="text-sm font-medium text-primary"><%= t(".no_accounts_title") %></p>
            <p class="text-sm text-secondary"><%= t(".no_accounts_description") %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
