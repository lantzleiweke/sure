<div class="space-y-4">
  <div class="prose prose-sm text-secondary">
    <p class="text-primary font-medium"><%= t("lunch_money_items.panel.setup_instructions") %></p>
    <ol>
      <li><%= t("lunch_money_items.panel.step_1") %></li>
      <li><%= t("lunch_money_items.panel.step_2") %></li>
      <li><%= t("lunch_money_items.panel.step_3") %></li>
    </ol>

    <p class="text-primary font-medium"><%= t("lunch_money_items.panel.field_descriptions") %></p>
    <ul>
      <li><strong><%= t("lunch_money_items.panel.fields.access_token.label") %>:</strong> <%= t("lunch_money_items.panel.fields.access_token.description") %> <%= t("lunch_money_items.panel.required") %></li>
    </ul>
  </div>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <div class="p-2 rounded-md bg-destructive/10 text-destructive text-sm overflow-hidden">
      <p class="line-clamp-3" title="<%= error_msg %>"><%= error_msg %></p>
    </div>
  <% end %>

  <%
    # Get or initialize a lunch_money_item for this family
    # - If family has an item WITH credentials, use it (for updates)
    # - If family has an item WITHOUT credentials, use it (to add credentials)
    # - If family has no items at all, create a new one
    lunch_money_item = Current.family.lunch_money_items.first_or_initialize(name: "Lunch Money Connection")
    is_new_record = lunch_money_item.new_record?
  %>

  <%= styled_form_with model: lunch_money_item,
                       url: is_new_record ? lunch_money_items_path : lunch_money_item_path(lunch_money_item),
                       scope: :lunch_money_item,
                       method: is_new_record ? :post : :patch,
                       data: { turbo: true },
                       class: "space-y-3" do |form| %>
    <%= form.text_field :access_token,
                        label: t("lunch_money_items.panel.fields.access_token.label"),
                        placeholder: is_new_record ? t("lunch_money_items.panel.fields.access_token.placeholder_new") : t("lunch_money_items.panel.fields.access_token.placeholder_update"),
                        type: :password %>

    <div class="flex justify-end">
      <%= form.submit is_new_record ? t("lunch_money_items.panel.save_button") : t("lunch_money_items.panel.update_button"),
                      class: "inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium btn btn--primary" %>
    </div>
  <% end %>

  <% items = local_assigns[:lunch_money_items] || @lunch_money_items || Current.family.lunch_money_items.where.not(access_token: [nil, ""]) %>
  <div class="flex items-center gap-2">
    <% if items&.any? %>
      <div class="w-2 h-2 bg-success rounded-full"></div>
      <p class="text-sm text-secondary"><%= t("lunch_money_items.panel.status_configured_html", accounts_path: accounts_path).html_safe %></p>
    <% else %>
      <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
      <p class="text-sm text-secondary"><%= t("lunch_money_items.panel.status_not_configured") %></p>
    <% end %>
  </div>
</div>
